{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "revisions",
    "outcome",
    "measurement_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "decision_id",
        "execution_id",
        "child_task_id",
        "invocation_id",
        "receipt_key",
        "source_event_id",
        "experiment_id",
        "child_occurrence",
        "source_event_hash",
        "source_cursor",
        "adapter_version"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "child_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "receipt_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "child_occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_cursor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "adapter_version": {
          "const": "diagnostic_measurement_v1"
        }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_revision",
        "source_revision",
        "environment_revision"
      ],
      "properties": {
        "subject_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "measurement_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
