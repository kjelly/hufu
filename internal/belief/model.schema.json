{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hufu.local/schemas/belief-model-v1",
  "title": "Finite Bayesian model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reducer_version",
    "id",
    "version",
    "synthetic",
    "prior_source",
    "independence_basis",
    "applicability",
    "hypotheses",
    "experiments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reducer_version": {
      "const": "finite_bayes_v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_.:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_.:-]+$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "prior_source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "independence_basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "applicability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "meaning",
          "prior_units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.:-]+$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "prior_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "correlation_group",
          "source",
          "outcomes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.:-]+$"
          },
          "correlation_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.:-]+$"
          },
          "source": {
            "enum": [
              "verification"
            ]
          },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "likelihood_units"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z0-9_.:-]+$"
                },
                "likelihood_units": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 32,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
