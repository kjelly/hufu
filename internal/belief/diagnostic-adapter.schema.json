{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "source",
    "experiments",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "const": "diagnostic_measurement_v1"
    },
    "source": {
      "const": "verification"
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_.:-]+$"
      }
    },
    "outcomes": {
      "const": [
        "pass",
        "fail"
      ]
    }
  }
}
