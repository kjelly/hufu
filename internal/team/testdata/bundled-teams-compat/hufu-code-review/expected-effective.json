{
  "team": {
    "name": "hufu-code-review",
    "description": "Read-only, artifact-backed review of the Hufu Go codebase",
    "max_rounds": 64,
    "max_steps": 120,
    "timeout": 3600,
    "verify_timeout": 120,
    "max_retries": 1,
    "max_concurrent": 3,
    "no_net": true,
    "unattended": true,
    "max_wall_clock": 86400,
    "acceptance_spec": {
      "require_no_unresolved_tasks": true,
      "mode": "blocking",
      "verifications": [
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/passed",
              "op": "equals",
              "value": true
            }
          ],
          "source_task": "verify-review-report",
          "output": "review_report_verification"
        },
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/requested",
              "op": "equals_input",
              "input": "review.scope"
            },
            {
              "pointer": "/requested_input_hash",
              "op": "equals_input_hash",
              "input": "review.scope"
            },
            {
              "pointer": "/satisfied",
              "op": "equals",
              "value": true
            },
            {
              "pointer": "/observed_budget/changed_paths",
              "op": "minimum",
              "value": 1
            }
          ],
          "source_task": "produce-workset",
          "output": "scope"
        },
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/requested",
              "op": "equals_input",
              "input": "review.scope"
            },
            {
              "pointer": "/requested_input_hash",
              "op": "equals_input_hash",
              "input": "review.scope"
            },
            {
              "pointer": "/satisfied",
              "op": "equals",
              "value": true
            }
          ],
          "source_task": "verify-targeted-go-tests",
          "output": "scope"
        },
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/passed",
              "op": "equals",
              "value": true
            }
          ],
          "source_task": "verify-targeted-go-tests",
          "output": "targeted_go_tests"
        },
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/passed",
              "op": "equals",
              "value": true
            }
          ],
          "source_task": "produce-workset",
          "output": "documentation_verification"
        },
        {
          "type": "workset_complete",
          "source_task": "review-primary-workset",
          "require_all_terminal": true,
          "require_all_verified": true,
          "accepted_statuses": [
            "success",
            "completed_with_gaps"
          ]
        },
        {
          "type": "workset_complete",
          "source_task": "review-documentation-workset",
          "require_all_terminal": true,
          "require_all_verified": true,
          "accepted_statuses": [
            "success",
            "completed_with_gaps"
          ]
        },
        {
          "type": "workset_complete",
          "source_task": "review-documentation-escalation",
          "require_all_terminal": true,
          "require_all_verified": true,
          "accepted_statuses": [
            "success",
            "completed_with_gaps"
          ]
        },
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/passed",
              "op": "equals",
              "value": true
            }
          ],
          "source_task": "inventory-review-handoffs",
          "output": "review_handoff_inventory"
        }
      ],
      "criteria": [
        {
          "id": "review-scope-attested",
          "required": true,
          "verify": {
            "type": "task_output_assert",
            "assertions": [
              {
                "pointer": "/requested",
                "op": "equals_input",
                "input": "review.scope"
              },
              {
                "pointer": "/requested_input_hash",
                "op": "equals_input_hash",
                "input": "review.scope"
              },
              {
                "pointer": "/satisfied",
                "op": "equals",
                "value": true
              },
              {
                "pointer": "/observed_budget/changed_paths",
                "op": "minimum",
                "value": 1
              }
            ],
            "source_task": "produce-workset",
            "output": "scope"
          }
        },
        {
          "id": "test-scope-attested",
          "required": true,
          "verify": {
            "type": "task_output_assert",
            "assertions": [
              {
                "pointer": "/requested",
                "op": "equals_input",
                "input": "review.scope"
              },
              {
                "pointer": "/requested_input_hash",
                "op": "equals_input_hash",
                "input": "review.scope"
              },
              {
                "pointer": "/satisfied",
                "op": "equals",
                "value": true
              }
            ],
            "source_task": "verify-targeted-go-tests",
            "output": "scope"
          }
        },
        {
          "id": "targeted-go-tests-passed",
          "required": true,
          "verify": {
            "type": "task_output_assert",
            "assertions": [
              {
                "pointer": "/passed",
                "op": "equals",
                "value": true
              }
            ],
            "source_task": "verify-targeted-go-tests",
            "output": "targeted_go_tests"
          }
        },
        {
          "id": "documentation-references-verified",
          "required": true,
          "verify": {
            "type": "task_output_assert",
            "assertions": [
              {
                "pointer": "/passed",
                "op": "equals",
                "value": true
              }
            ],
            "source_task": "produce-workset",
            "output": "documentation_verification"
          }
        },
        {
          "id": "primary-reviews-complete",
          "required": true,
          "depends_on": [
            "review-scope-attested",
            "test-scope-attested",
            "targeted-go-tests-passed",
            "documentation-references-verified"
          ],
          "verify": {
            "type": "workset_complete",
            "source_task": "review-primary-workset",
            "require_all_terminal": true,
            "require_all_verified": true,
            "accepted_statuses": [
              "success",
              "completed_with_gaps"
            ]
          }
        },
        {
          "id": "documentation-reviews-complete",
          "required": true,
          "depends_on": [
            "review-scope-attested"
          ],
          "verify": {
            "type": "workset_complete",
            "source_task": "review-documentation-workset",
            "require_all_terminal": true,
            "require_all_verified": true,
            "accepted_statuses": [
              "success",
              "completed_with_gaps"
            ]
          }
        },
        {
          "id": "documentation-escalation-complete",
          "required": true,
          "depends_on": [
            "review-scope-attested"
          ],
          "verify": {
            "type": "workset_complete",
            "source_task": "review-documentation-escalation",
            "require_all_terminal": true,
            "require_all_verified": true,
            "accepted_statuses": [
              "success",
              "completed_with_gaps"
            ]
          }
        },
        {
          "id": "review-handoffs-inventoried",
          "required": true,
          "depends_on": [
            "primary-reviews-complete",
            "documentation-reviews-complete",
            "documentation-escalation-complete"
          ],
          "verify": {
            "type": "task_output_assert",
            "assertions": [
              {
                "pointer": "/passed",
                "op": "equals",
                "value": true
              }
            ],
            "source_task": "inventory-review-handoffs",
            "output": "review_handoff_inventory"
          }
        },
        {
          "id": "review-report-audited",
          "required": true,
          "depends_on": [
            "review-handoffs-inventoried",
            "test-scope-attested",
            "targeted-go-tests-passed"
          ],
          "verify": {
            "type": "task_output_assert",
            "assertions": [
              {
                "pointer": "/passed",
                "op": "equals",
                "value": true
              }
            ],
            "source_task": "verify-review-report",
            "output": "review_report_verification"
          }
        }
      ]
    },
    "execution_profile": "fresh-session",
    "goal_mode": "outcome",
    "workflow": {
      "phases": [
        "prepare",
        "verify"
      ]
    },
    "policies": {
      "require_phase_success": true,
      "allow_phase_skip": true
    },
    "capabilities": {
      "required": [
        "produce-workset",
        "verify-review-tests",
        "inventory-review-handoffs",
        "verify-review-report"
      ]
    },
    "verification": {
      "required": true
    },
    "retry": {
      "transient": {
        "max_attempts": 1
      },
      "repair": {
        "max_attempts_per_failure_signature": 1
      }
    },
    "delegation": {
      "AllowedWorkers": [
        "reviewer",
        "documentation-reviewer",
        "critic",
        "synthesizer"
      ],
      "InitialBatch": null,
      "RequireExactInitialBatch": false,
      "InitialCoordinatorTool": "",
      "BindInitialTaskContracts": false,
      "BindTaskGoalContracts": true,
      "NoRedispatchAfterSuccess": [
        "reviewer",
        "documentation-reviewer",
        "synthesizer"
      ],
      "ForbidContextFiles": true,
      "TaskGoalInvariants": null,
      "CapabilityRouting": null,
      "RequireTaskContract": null,
      "ShareRequestWith": null
    }
  },
  "agents": [
    {
      "name": "coordinator",
      "role": "coordinator",
      "tools": "ask_user,view",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": -1,
      "max_steps": 80
    },
    {
      "name": "critic",
      "role": "worker",
      "tools": "view",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": 1,
      "max_steps": 20
    },
    {
      "name": "documentation-reviewer",
      "role": "worker",
      "tools": "view",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": 1,
      "max_steps": 40
    },
    {
      "name": "Helper",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,random,math",
      "max_retries": -1
    },
    {
      "name": "reviewer",
      "role": "worker",
      "tools": "view",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": 1,
      "max_steps": 120
    },
    {
      "name": "synthesizer",
      "role": "worker",
      "tools": "view",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": 1,
      "max_steps": 12
    }
  ],
  "tasks": [
    {
      "id": "produce-workset",
      "agent": "reviewer",
      "phase": "PREPARE",
      "side_effect": "none",
      "recovery": "retry"
    },
    {
      "id": "verify-targeted-go-tests",
      "agent": "reviewer",
      "phase": "PREPARE",
      "side_effect": "none",
      "recovery": "retry"
    },
    {
      "id": "review-primary-workset",
      "agent": "reviewer",
      "phase": "VERIFY"
    },
    {
      "id": "review-documentation-workset",
      "agent": "documentation-reviewer",
      "phase": "VERIFY"
    },
    {
      "id": "review-documentation-escalation",
      "agent": "critic",
      "phase": "VERIFY"
    },
    {
      "id": "critic-review",
      "agent": "critic",
      "phase": "VERIFY",
      "optional": true
    },
    {
      "id": "inventory-review-handoffs",
      "agent": "reviewer",
      "phase": "VERIFY",
      "side_effect": "none",
      "recovery": "retry",
      "optional": true
    },
    {
      "id": "synthesize-review",
      "agent": "synthesizer",
      "phase": "VERIFY",
      "side_effect": "none",
      "recovery": "retry",
      "optional": true
    },
    {
      "id": "verify-review-report",
      "agent": "reviewer",
      "phase": "VERIFY",
      "side_effect": "none",
      "recovery": "retry",
      "optional": true
    }
  ]
}
