{
  "team": {
    "name": "hufu-code-review",
    "description": "Read-only, artifact-backed review of the Hufu Go codebase",
    "max_rounds": 64,
    "max_steps": 120,
    "timeout": 3600,
    "verify_timeout": 120,
    "max_retries": 1,
    "max_concurrent": 3,
    "no_net": true,
    "unattended": true,
    "max_wall_clock": 86400,
    "acceptance_spec": {
      "require_no_unresolved_tasks": true,
      "mode": "blocking",
      "verifications": [
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/requested",
              "op": "equals_input",
              "input": "review.scope"
            },
            {
              "pointer": "/requested_input_hash",
              "op": "equals_input_hash",
              "input": "review.scope"
            },
            {
              "pointer": "/satisfied",
              "op": "equals",
              "value": true
            },
            {
              "pointer": "/observed_budget/changed_paths",
              "op": "minimum",
              "value": 1
            }
          ],
          "source_task": "produce-workset",
          "output": "scope"
        },
        {
          "type": "task_output_assert",
          "assertions": [
            {
              "pointer": "/passed",
              "op": "equals",
              "value": true
            }
          ],
          "source_task": "produce-workset",
          "output": "documentation_verification"
        },
        {
          "type": "workset_complete",
          "source_task": "review-primary-workset",
          "require_all_terminal": true,
          "require_all_verified": true,
          "accepted_statuses": [
            "success",
            "completed_with_gaps"
          ]
        },
        {
          "type": "workset_complete",
          "source_task": "review-documentation-workset",
          "require_all_terminal": true,
          "require_all_verified": true,
          "accepted_statuses": [
            "success",
            "completed_with_gaps"
          ]
        },
        {
          "type": "workset_complete",
          "source_task": "review-documentation-escalation",
          "require_all_terminal": true,
          "require_all_verified": true,
          "accepted_statuses": [
            "success",
            "completed_with_gaps"
          ]
        }
      ]
    },
    "execution_profile": "fresh-session",
    "goal_mode": "outcome",
    "workflow": {
      "phases": [
        "prepare",
        "verify"
      ]
    },
    "policies": {
      "require_phase_success": true,
      "allow_phase_skip": true,
      "fail_fast": true
    },
    "capabilities": {
      "required": [
        "produce-workset"
      ]
    },
    "verification": {
      "required": true
    },
    "retry": {
      "transient": {
        "max_attempts": 1
      },
      "repair": {
        "max_attempts_per_failure_signature": 1
      }
    },
    "delegation": {
      "AllowedWorkers": [
        "reviewer",
        "documentation-reviewer",
        "critic"
      ],
      "InitialBatch": null,
      "RequireExactInitialBatch": false,
      "InitialCoordinatorTool": "",
      "BindInitialTaskContracts": false,
      "BindTaskGoalContracts": true,
      "NoRedispatchAfterSuccess": [
        "reviewer",
        "documentation-reviewer"
      ],
      "ForbidContextFiles": false,
      "TaskGoalInvariants": null,
      "CapabilityRouting": null
    }
  },
  "agents": [
    {
      "name": "coordinator",
      "role": "coordinator",
      "tools": "ask_user,view",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": -1,
      "max_steps": 80
    },
    {
      "name": "critic",
      "role": "worker",
      "tools": "view,grep,glob,ls",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": 1,
      "max_steps": 20
    },
    {
      "name": "documentation-reviewer",
      "role": "worker",
      "tools": "view,grep,glob,ls",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": 1,
      "max_steps": 40
    },
    {
      "name": "Helper",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,random,math",
      "max_retries": -1
    },
    {
      "name": "reviewer",
      "role": "worker",
      "tools": "view,grep,glob,ls",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": 1,
      "max_steps": 120
    }
  ],
  "tasks": [
    {
      "id": "produce-workset",
      "agent": "reviewer",
      "phase": "PREPARE",
      "when_goal_contains": "produce workset",
      "side_effect": "none",
      "recovery": "retry"
    },
    {
      "id": "review-primary-workset",
      "agent": "reviewer",
      "phase": "VERIFY",
      "when_goal_contains": "review primary workset"
    },
    {
      "id": "review-documentation-workset",
      "agent": "documentation-reviewer",
      "phase": "VERIFY",
      "when_goal_contains": "review documentation workset"
    },
    {
      "id": "review-documentation-escalation",
      "agent": "critic",
      "phase": "VERIFY",
      "when_goal_contains": "review documentation escalation"
    },
    {
      "id": "critic-review",
      "agent": "critic",
      "phase": "VERIFY",
      "when_goal_contains": "critic review",
      "optional": true
    }
  ]
}
