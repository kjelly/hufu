{
  "team": {
    "name": "strategic-decision",
    "description": "Decision-runtime example with separate auxiliary V1 review and a runtime-owned primary V2 decision profile.\n",
    "max_rounds": 10,
    "max_steps": 20,
    "timeout": 600,
    "verify_timeout": 120,
    "max_retries": 2,
    "max_concurrent": 5,
    "max_wall_clock": 3600,
    "max_total_tokens": 200000,
    "tools_allowed": [
      "view",
      "grep",
      "glob",
      "ls"
    ],
    "delegation": {
      "AllowedWorkers": [
        "reference",
        "reference-specialist",
        "juror",
        "challenger"
      ],
      "InitialBatch": null,
      "RequireExactInitialBatch": false,
      "InitialCoordinatorTool": "",
      "BindInitialTaskContracts": false,
      "BindTaskGoalContracts": false,
      "NoRedispatchAfterSuccess": null,
      "ForbidContextFiles": false,
      "TaskGoalInvariants": null,
      "CapabilityRouting": null
    }
  },
  "agents": [
    {
      "name": "challenger",
      "role": "worker",
      "tools": "view,grep,glob,ls",
      "side_effect": "none",
      "max_retries": -1
    },
    {
      "name": "coordinator",
      "role": "coordinator",
      "tools": "view,grep,glob,ls",
      "max_retries": -1
    },
    {
      "name": "Helper",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,random,math",
      "max_retries": -1
    },
    {
      "name": "juror",
      "role": "worker",
      "tools": "view,grep,glob,ls",
      "side_effect": "none",
      "max_retries": -1
    },
    {
      "name": "reference",
      "role": "worker",
      "tools": "view,grep,glob,ls",
      "side_effect": "none",
      "max_retries": -1
    },
    {
      "name": "reference-specialist",
      "role": "worker",
      "tools": "view,grep,glob,ls",
      "side_effect": "none",
      "max_retries": -1
    }
  ]
}
