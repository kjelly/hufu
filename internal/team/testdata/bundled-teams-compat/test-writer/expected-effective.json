{
  "team": {
    "name": "test-writer",
    "description": "Starter team for generating and maintaining tests. Includes a test-writer worker and a code-reviewer-style critic.",
    "max_rounds": 5,
    "timeout": 1800,
    "verify_timeout": 120,
    "max_retries": 2
  },
  "agents": [
    {
      "name": "coordinator",
      "role": "coordinator",
      "tools": "ask_user",
      "max_retries": -1
    },
    {
      "name": "Helper",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,random,math",
      "max_retries": -1
    },
    {
      "name": "test-critic",
      "role": "worker",
      "tools": "view,bash,grep,wait_for",
      "max_retries": -1
    },
    {
      "name": "test-writer",
      "role": "worker",
      "tools": "view,write,edit,bash,grep,glob,wait_for",
      "max_retries": -1
    }
  ]
}
