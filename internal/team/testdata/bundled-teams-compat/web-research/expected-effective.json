{
  "team": {
    "name": "web-research",
    "description": "Independently research factual claims online, verify source evidence, and synthesize an evidence-qualified answer",
    "max_rounds": 8,
    "timeout": 600,
    "verify_timeout": 120,
    "max_retries": 1,
    "max_concurrent": 2,
    "acceptance_spec": {
      "required_workers": [
        "researcher",
        "countercheck",
        "verifier",
        "synthesizer"
      ],
      "required_workers_accept_gaps": true,
      "require_no_unresolved_tasks": true,
      "mode": "blocking"
    },
    "goal_mode": "outcome",
    "tools_denied": [
      "web_fetch",
      "write",
      "edit",
      "multiedit",
      "bash",
      "sudo",
      "ssh",
      "scp",
      "lua",
      "golang",
      "download",
      "fetch",
      "agentic_fetch",
      "grep",
      "glob",
      "ls",
      "random",
      "math"
    ],
    "workflow": {
      "phases": [
        "prepare",
        "audit",
        "verify"
      ]
    },
    "policies": {
      "require_phase_success": true,
      "allow_phase_skip": true
    },
    "verification": {
      "required": true
    },
    "delegation": {
      "AllowedWorkers": [
        "researcher",
        "countercheck",
        "verifier",
        "synthesizer"
      ],
      "InitialBatch": null,
      "RequireExactInitialBatch": false,
      "InitialCoordinatorTool": "",
      "BindInitialTaskContracts": false,
      "BindTaskGoalContracts": true,
      "NoRedispatchAfterSuccess": [
        "researcher",
        "countercheck",
        "verifier",
        "synthesizer"
      ],
      "ForbidContextFiles": true,
      "TaskGoalInvariants": null,
      "CapabilityRouting": null,
      "RequireTaskContract": null,
      "ShareRequestWith": [
        "researcher",
        "countercheck",
        "verifier",
        "synthesizer"
      ]
    }
  },
  "agents": [
    {
      "name": "coordinator",
      "role": "coordinator",
      "tools": "ask_user",
      "max_retries": -1
    },
    {
      "name": "countercheck",
      "role": "worker",
      "tools": "web_search,recall_observation,playwright_countercheck__browser_navigate,playwright_countercheck__browser_snapshot",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": -1
    },
    {
      "name": "Helper",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,random,math",
      "max_retries": -1
    },
    {
      "name": "researcher",
      "role": "worker",
      "tools": "web_search,recall_observation,playwright_researcher__browser_navigate,playwright_researcher__browser_snapshot",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": -1
    },
    {
      "name": "synthesizer",
      "role": "worker",
      "tools": "submit_result",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": -1
    },
    {
      "name": "verifier",
      "role": "worker",
      "tools": "web_search,playwright_verifier__browser_navigate,playwright_verifier__browser_snapshot",
      "side_effect": "none",
      "recovery": "retry",
      "max_retries": -1
    }
  ],
  "tasks": [
    {
      "id": "primary-research",
      "agent": "researcher",
      "phase": "PREPARE",
      "side_effect": "none",
      "recovery": "retry"
    },
    {
      "id": "counter-research",
      "agent": "countercheck",
      "phase": "PREPARE",
      "side_effect": "none",
      "recovery": "retry"
    },
    {
      "id": "evidence-audit",
      "agent": "verifier",
      "phase": "AUDIT",
      "side_effect": "none",
      "recovery": "retry"
    },
    {
      "id": "research-synthesis",
      "agent": "synthesizer",
      "phase": "VERIFY",
      "side_effect": "none",
      "recovery": "retry"
    }
  ]
}
