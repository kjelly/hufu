{
  "team": {
    "name": "unattended-fixture",
    "description": "Unattended high-risk operational team, deny-by-default",
    "max_rounds": 10,
    "timeout": 600,
    "verify_timeout": 120,
    "max_retries": 2,
    "unattended": true,
    "max_wall_clock": 3600,
    "max_total_tokens": 200000,
    "tools_allowed": [
      "view",
      "grep",
      "glob",
      "ls",
      "bash",
      "ssh",
      "wait_for"
    ]
  },
  "agents": [
    {
      "name": "Helper",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,random,math",
      "max_retries": -1
    },
    {
      "name": "operator",
      "role": "worker",
      "tools": "view,grep,glob,ls,bash,ssh,wait_for",
      "side_effect": "infra_mutation",
      "recovery": "reconcile",
      "max_retries": -1
    }
  ]
}
