{
  "team": {
    "name": "team",
    "max_rounds": 10,
    "timeout": 600,
    "verify_timeout": 120,
    "max_retries": 2
  },
  "agents": [
    {
      "name": "developer",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,bash,wait_for",
      "side_effect": "workspace_write",
      "max_retries": -1
    },
    {
      "name": "Helper",
      "role": "worker",
      "tools": "view,write,edit,multiedit,grep,glob,ls,random,math",
      "max_retries": -1
    },
    {
      "name": "reviewer",
      "role": "worker",
      "tools": "view,grep,glob,ls,bash,wait_for",
      "side_effect": "none",
      "max_retries": -1
    }
  ]
}
