{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "failures",
    "gaps"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "failures": {
      "$ref": "#/$defs/texts"
    },
    "gaps": {
      "$ref": "#/$defs/texts"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 1000
    },
    "texts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "outcome",
        "exit_code",
        "note"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 2000
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "fail"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "unverified"
              }
            }
          },
          "then": {
            "properties": {
              "note": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  }
}
