{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "failures",
    "gaps",
    "implementation_gap_assessments"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "failures": {
      "$ref": "#/$defs/texts"
    },
    "gaps": {
      "$ref": "#/$defs/texts"
    },
    "implementation_gap_assessments": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_task_id",
          "source_index",
          "reported_gap",
          "assessment",
          "reason"
        ],
        "properties": {
          "source_task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 200
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          },
          "reported_gap": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 1000
          },
          "assessment": {
            "type": "string",
            "enum": [
              "addressed",
              "unresolved",
              "unverified"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 1500
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 1000
    },
    "texts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "outcome",
        "exit_code",
        "note"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 2000
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "fail"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "unverified"
              }
            }
          },
          "then": {
            "properties": {
              "note": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  },
  "x-hufu-fixed-collections": [
    {
      "items_pointer": "/implementation_gap_assessments",
      "source_contracts": [
        "schemas/implementation-v1.json"
      ],
      "source_pointer": "/gaps",
      "task_id_field": "source_task_id",
      "index_field": "source_index",
      "value_bindings": {
        "reported_gap": ""
      },
      "choice_fields": [
        "assessment"
      ],
      "source_scope": "dependency_results"
    }
  ]
}
