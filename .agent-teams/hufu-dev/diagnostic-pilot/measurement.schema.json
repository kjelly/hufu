{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_ref",
    "experiment_id",
    "outcome",
    "measurement_digest"
  ],
  "properties": {
    "fixture_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "experiment_id": {
      "enum": [
        "check_source",
        "check_environment"
      ]
    },
    "outcome": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "measurement_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
