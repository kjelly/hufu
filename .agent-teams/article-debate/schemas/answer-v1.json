{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answerability", "answer", "citations", "dissent", "missing_information"],
  "properties": {
    "answerability": {"type": "string", "enum": ["supported", "partial", "insufficient"]},
    "answer": {"type": "string", "minLength": 1, "maxLength": 6000},
    "citations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "location", "supports"],
        "properties": {
          "quote": {"type": "string", "minLength": 1, "maxLength": 350},
          "location": {"type": "string", "minLength": 1, "maxLength": 200},
          "supports": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "dissent": {"type": "string", "minLength": 1, "maxLength": 2000},
    "missing_information": {"type": "string", "minLength": 1, "maxLength": 2000}
  },
  "if": {"properties": {"answerability": {"const": "supported"}}},
  "then": {"properties": {"citations": {"minItems": 1}}}
}
