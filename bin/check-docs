#!/usr/bin/env bash

set -euo pipefail

# CDPATH makes cd print the resolved directory, which would corrupt repo_root.
repo_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

mapfile -t active_docs < <(
	find docs -type f -name '*.md' \
		-not -path 'docs/archive/*' \
		-not -path 'docs/tmp/*' \
		-print | sort
)

if ((${#active_docs[@]} == 0)); then
	echo "check-docs: no active documentation files found" >&2
	exit 1
fi

status_fields=(Status Authority Verified-Commit Supersedes Superseded-By)
for file in "${active_docs[@]}"; do
	header=$(sed -n '1,24p' "$file")
	for field in "${status_fields[@]}"; do
		if ! grep -Eq "(^|> )[[:space:]]*${field}:" <<<"$header"; then
			echo "check-docs: $file is missing header field $field" >&2
			exit 1
		fi
	done
done

# Only POSIX tools are used so every check actually runs on a stock CI runner.
# grep exits 0 on a match, 1 on no match, and >1 on an error; an error must fail
# the check instead of reading as "no match".
retired_status=0
grep -nE \
	'file:///|docs/hufu-(future-improvement-roadmap|generic-workset-evidence-plan|coding-team-spec|runtime-composability-spec|external-coding-agent-runtime-spec|incomplete-run-reliability-plan|model-metadata-runtime-introspection-spec|outcome-driven-memory-hf-mem4-implementation-spec|ltm-promotion-spec|decision-aware-runtime-spec|per-worker-memory-implementation-plan|canonical-memory-hf-mem3-implementation-plan|strict-verification-workflow-improvement|ssh-tool-usage)\.md' \
	"${active_docs[@]}" || retired_status=$?
if ((retired_status == 0)); then
	echo "check-docs: active documentation contains a machine-local or retired path" >&2
	exit 1
elif ((retired_status != 1)); then
	echo "check-docs: retired-path scan failed (grep exit $retired_status)" >&2
	exit 2
fi

missing=0
link_count=0
for file in "${active_docs[@]}"; do
	links_status=0
	links=$(grep -ohE '[]][(][^)]*[)]' "$file") || links_status=$?
	if ((links_status > 1)); then
		echo "check-docs: link scan failed for $file (grep exit $links_status)" >&2
		exit 2
	fi
	while IFS= read -r raw; do
		[[ -n "$raw" ]] || continue
		target=${raw#\](}
		target=${target%)}
		target=${target%%\#*}
		target=${target%%\?*}
		target=${target#<}
		target=${target%>}
		case "$target" in
			''|http://*|https://*|mailto:*|file://*|'#'*) continue ;;
		esac
		case "$target" in
			/*) path="$target" ;;
			*) path="$(dirname "$file")/$target" ;;
		esac
		link_count=$((link_count + 1))
		if [[ ! -e "$path" ]]; then
			echo "check-docs: $file links to missing path $target" >&2
			missing=1
		fi
	done <<<"$links"
done

if ((missing)); then
	exit 1
fi

echo "check-docs: ${#active_docs[@]} active files and $link_count relative links are valid"
