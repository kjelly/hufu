{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "logical_decision_run"
    },
    "logical_run_id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^ldr_[0-9a-f]{32}$"
    },
    "branch_id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:@/-]+$"
    },
    "team_id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:@/-]+$"
    },
    "team_definition_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirement_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:@/-]+$"
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "sha256",
        "media_type",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "requirement_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_bundle_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:@/-]+$"
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "sha256",
        "media_type",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "execution_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9_.:@/-]+$"
      },
      "maxItems": 256
    },
    "owner_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "phase": {
      "enum": [
        "SUPPORTING",
        "PREPARED",
        "ADMITTED",
        "BOUND",
        "SUSPENDED",
        "CLOSED",
        "RECOVERY_REQUIRED"
      ]
    },
    "current_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_primary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "logical_run_id": {
              "type": "string",
              "maxLength": 36,
              "pattern": "^ldr_[0-9a-f]{32}$"
            },
            "branch_id": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_.:@/-]+$"
            },
            "task_id": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_.:@/-]+$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "decision_id": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_.:@/-]+$"
            },
            "requirement_digest": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "support_revision_digest": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "admission_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9_.:@/-]+$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 128
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "sha256",
                "media_type",
                "size_bytes"
              ],
              "additionalProperties": false
            },
            "base_evidence_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9_.:@/-]+$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 128
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "sha256",
                "media_type",
                "size_bytes"
              ],
              "additionalProperties": false
            },
            "role_plan_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9_.:@/-]+$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 128
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "sha256",
                "media_type",
                "size_bytes"
              ],
              "additionalProperties": false
            },
            "record_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9_.:@/-]+$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 128
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "sha256",
                "media_type",
                "size_bytes"
              ],
              "additionalProperties": false
            },
            "sealed_evidence_hash": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "schema_version",
            "logical_run_id",
            "branch_id",
            "task_id",
            "generation",
            "decision_id",
            "requirement_digest",
            "support_revision_digest",
            "admission_ref",
            "base_evidence_ref",
            "role_plan_ref",
            "record_ref",
            "sealed_evidence_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "last_applied_event_id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:@/-]+$"
    },
    "last_applied_hash": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserved_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generations_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invocation_settlements_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9_.:@/-]+$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 128
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "sha256",
                "media_type",
                "size_bytes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokens_used",
        "reserved_tokens",
        "active_duration_ms",
        "generations_started",
        "invocation_settlements_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "logical_run_id",
    "branch_id",
    "team_id",
    "team_definition_digest",
    "requirement_ref",
    "requirement_digest",
    "profile_bundle_ref",
    "execution_run_ids",
    "owner_epoch",
    "phase",
    "current_generation",
    "active_primary",
    "last_applied_event_id",
    "last_applied_hash",
    "usage"
  ],
  "additionalProperties": false
}
