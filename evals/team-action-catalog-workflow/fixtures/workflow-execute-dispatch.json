{
  "steps": [
    {
      "tool_call": {
        "name": "agent",
        "arguments": "{\"tasks\": [{\"agent\": \"preparer\", \"goal\": \"prepare the staging release\", \"contract_id\": \"prepare-release\"}]}"
      }
    },
    {
      "tool_call": {
        "name": "submit_result",
        "arguments": "{\"status\": \"success\", \"summary\": \"Prepared the release.\"}"
      }
    },
    {
      "tool_call": {
        "name": "agent",
        "arguments": "{\"tasks\": [{\"agent\": \"executor\", \"goal\": \"check the staging window\", \"catalog_action\": {\"id\": \"check-window\", \"arguments\": {\"environment\": \"staging\"}}}]}"
      }
    },
    {
      "tool_call": {
        "name": "agent",
        "arguments": "{\"tasks\": [{\"agent\": \"executor\", \"goal\": \"apply the staging release\", \"contract_id\": \"apply-release\"}]}"
      }
    },
    {
      "tool_call": {
        "name": "submit_result",
        "arguments": "{\"status\": \"success\", \"summary\": \"Applied the release.\"}"
      }
    },
    {
      "tool_call": {
        "name": "agent",
        "arguments": "{\"tasks\": [{\"agent\": \"verifier\", \"goal\": \"verify the staging release\", \"contract_id\": \"verify-release\"}]}"
      }
    },
    {
      "tool_call": {
        "name": "submit_result",
        "arguments": "{\"status\": \"success\", \"summary\": \"Verified the release.\"}"
      }
    },
    {
      "tool_call": {
        "name": "finish",
        "arguments": "{\"response\": \"Released to staging.\", \"acknowledge_failed_tasks\": false}"
      }
    },
    {
      "match": {"contains": "FINISHED:"},
      "forbidden": true,
      "content": "unexpected provider call after finish"
    }
  ]
}
