{
  "steps": [
    {
      "tool_call": {
        "name": "agent",
        "arguments": "{\"tasks\": [{\"agent\": \"declared\", \"goal\": \"Print shell-ok with echo.\"}]}"
      }
    },
    {
      "tool_call": {
        "name": "bash",
        "arguments": "{\"command\": \"echo shell-ok\"}"
      }
    },
    {
      "match": {
        "contains": "Exit code: 0"
      },
      "tool_call": {
        "name": "submit_result",
        "arguments": "{\"status\": \"success\", \"summary\": \"Ran the command.\"}"
      }
    },
    {
      "tool_call": {
        "name": "finish",
        "arguments": "{\"response\": \"Done.\", \"acknowledge_failed_tasks\": false}"
      }
    },
    {
      "match": {"contains": "FINISHED:"},
      "forbidden": true,
      "content": "unexpected provider call after finish"
    }
  ]
}
