{
  "steps": [
    {
      "tool_call": {
        "name": "agent",
        "arguments": "{\"tasks\": [{\"agent\": \"checker\", \"goal\": \"Check the input.\"}]}"
      }
    },
    {
      "tool_call": {
        "name": "submit_plan",
        "arguments": "{\"plan\": \"1. Assume the input is present.\"}"
      }
    },
    {
      "tool_call": {
        "name": "reject_plan",
        "arguments": "{\"todo_id\": \"1\", \"reason\": \"the plan never reads the input\"}"
      }
    },
    {
      "match": {
        "contains": "plan rejected, task skipped"
      },
      "tool_call": {
        "name": "finish",
        "arguments": "{\"response\": \"The plan was rejected, so the input was not checked.\", \"acknowledge_failed_tasks\": true}"
      }
    },
    {
      "match": {"contains": "FINISHED:"},
      "forbidden": true,
      "content": "unexpected provider call after finish"
    }
  ]
}
