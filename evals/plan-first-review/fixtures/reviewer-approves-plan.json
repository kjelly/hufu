{
  "steps": [
    {
      "tool_call": {
        "name": "agent",
        "arguments": "{\"tasks\": [{\"agent\": \"worker\", \"goal\": \"Say hello to the user.\"}]}"
      }
    },
    {
      "tool_call": {
        "name": "submit_plan",
        "arguments": "{\"plan\": \"1. Say hello to the user.\"}"
      }
    },
    {
      "match": {
        "contains": "runtime_plan_review"
      },
      "content": "{\"token\":\"A0\"}"
    },
    {
      "tool_call": {
        "name": "submit_result",
        "arguments": "{\"status\": \"success\", \"summary\": \"Said hello.\"}"
      }
    },
    {
      "tool_call": {
        "name": "finish",
        "arguments": "{\"response\": \"Hello! Task complete.\"}"
      }
    },
    {
      "match": {
        "contains": "FINISHED:"
      },
      "forbidden": true,
      "content": "unexpected provider call after finish"
    }
  ]
}
